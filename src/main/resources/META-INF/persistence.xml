<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="mariadb-pu">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>core.entities.Customer</class>
        <class>core.entities.Invoice</class>
        <class>core.entities.InvoiceLine</class>
        <class>core.entities.Lot</class>
        <class>core.entities.LotAllocation</class>
        <class>core.entities.Measurement</class>
        <class>core.entities.Product</class>
        <class>core.entities.Promotion</class>
        <class>core.entities.PromotionAction</class>
        <class>core.entities.PromotionCondition</class>
        <class>core.entities.Shift</class>
        <class>core.entities.Staff</class>
        <class>core.entities.UnitOfMeasure</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.mariadb.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mariadb://localhost:3306/mediwow"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password"
                      value="sapassword"/>
            <property name="jakarta.persistence.jdbc.dialect"
                      value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>

    </persistence-unit>
</persistence>
